page {
  background: #f6f7f9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  padding: 28rpx;
}

.header {
  padding: 20rpx 0 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.5;
}

.panel {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  color: #6b7280;
  font-size: 28rpx;
}

.value {
  font-size: 28rpx;
  font-weight: 600;
}

.actions {
  display: grid;
  gap: 16rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.json {
  white-space: pre-wrap;
  word-break: break-all;
  color: #1f2937;
  background: #f9fafb;
  border-radius: 8rpx;
  padding: 18rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.empty {
  color: #9ca3af;
  font-size: 26rpx;
}

.error {
  margin-bottom: 24rpx;
  padding: 18rpx;
  color: #991b1b;
  background: #fee2e2;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.copy {
  margin: 8rpx 0 24rpx;
}

.log-item + .log-item {
  margin-top: 18rpx;
}

.log-title {
  margin-bottom: 8rpx;
  color: #374151;
  font-size: 24rpx;
  font-weight: 600;
}
