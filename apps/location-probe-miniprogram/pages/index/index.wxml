<view class="page">
  <view class="header">
    <view class="title">微信定位能力测试</view>
    <view class="subtitle">只验证 getLocation / chooseLocation，不进入正式饭点流程。</view>
  </view>

  <view class="panel">
    <view class="row">
      <text class="label">授权状态</text>
      <text class="value">{{authStatus}}</text>
    </view>
    <view class="actions">
      <button type="primary" loading="{{loading}}" bindtap="getCurrentLocation">获取当前位置</button>
      <button bindtap="chooseLocation">手动选择位置</button>
      <button bindtap="openSetting">打开授权设置</button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">
    {{error}}
  </view>

  <view class="panel">
    <view class="section-title">当前位置</view>
    <view wx:if="{{location}}" class="json">{{locationText}}</view>
    <view wx:else class="empty">还没有获取当前位置。</view>
  </view>

  <view class="panel">
    <view class="section-title">手选位置</view>
    <view wx:if="{{chosenLocation}}" class="json">{{chosenLocationText}}</view>
    <view wx:else class="empty">还没有手动选择位置。</view>
  </view>

  <button class="copy" bindtap="copyPayload">复制定位 JSON</button>

  <view class="panel">
    <view class="section-title">调用日志</view>
    <block wx:for="{{logs}}" wx:key="time">
      <view class="log-item">
        <view class="log-title">{{item.time}} · {{item.label}}</view>
        <view class="json">{{item.payload}}</view>
      </view>
    </block>
    <view wx:if="{{logs.length === 0}}" class="empty">还没有调用记录。</view>
  </view>
</view>
