<view class="page">
  <view class="topbar">
    <view>
      <text class="brand">饭点定了</text>
    </view>
    <view wx:if="{{stage !== 'entry'}}" class="status-pill">{{stageSubtitle}}</view>
  </view>

  <view wx:if="{{bootNotice}}" class="notice">{{bootNotice}}</view>
  <view wx:if="{{errorText}}" class="error">{{errorText}}</view>

  <view wx:if="{{stage === 'entry'}}" class="entry-panel">
    <view class="entry-title-row">
      <view class="section-title entry-title">今天想怎么吃？</view>
      <button class="location-chip" bindtap="getLocation">{{locationText}}</button>
    </view>
    <view class="xiaowang-card">
      <image class="xiaowang-mascot" src="{{xiaowangMascotUrl}}" mode="aspectFit" />
      <view class="xiaowang-copy">
        <view class="xiaowang-name">小汪</view>
        <view class="xiaowang-line">先选几项，也可以直接把今天的想法告诉我。</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">人数</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.partySize}}"
          wx:key="value"
          class="option-pill {{entryForm.partySize === item.value ? 'active' : ''}}"
          data-field="partySize"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="budget-head">
        <view class="field-label">预算</view>
        <view class="budget-value">{{entryForm.budget === '500' ? '先不限制' : entryForm.budget + ' 元以内'}}</view>
      </view>
      <slider
        class="budget-slider"
        min="0"
        max="500"
        step="10"
        value="{{entryForm.budget}}"
        activeColor="#ff6334"
        backgroundColor="rgba(125, 78, 44, 0.14)"
        block-color="#ff6334"
        block-size="24"
        bindchanging="onBudgetChange"
        bindchange="onBudgetChange"
      />
      <view class="budget-scale">
        <text>0</text>
        <text>250</text>
        <text>不限</text>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">距离</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.radius}}"
          wx:key="value"
          class="option-pill {{entryForm.radius === item.value ? 'active' : ''}}"
          data-field="radius"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">口味</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.flavor}}"
          wx:key="value"
          class="option-pill {{entryForm.flavor === item.value ? 'active' : ''}}"
          data-field="flavor"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">今天想怎么吃</view>
      <textarea
        class="entry-textarea"
        value="{{entryForm.text}}"
        maxlength="160"
        bindinput="onEntryTextInput"
        placeholder="比如：今天下班有点累，想吃点热乎下饭的。"
      />
    </view>

    <view class="entry-actions">
      <button
        wx:if="{{resumableSessionId}}"
        class="secondary-button entry-secondary"
        loading="{{isLoading}}"
        bindtap="restoreSession"
      >继续上次</button>
      <button class="primary-button entry-primary" loading="{{isLoading}}" bindtap="startMealFlow">开始新一轮</button>
    </view>
  </view>

  <view wx:elif="{{stage === 'direction' || stage === 'offer'}}" class="flow {{stage === 'offer' ? 'offer-flow' : ''}}">
    <view wx:if="{{stage === 'direction'}}" class="direction-brief">
      <image class="direction-brief-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
      <view class="direction-brief-copy">先滑几张方向卡，喜欢的留下，不喜欢的划走，后面再看具体店。</view>
    </view>
    <view wx:if="{{stage === 'direction' && !isEditingGoal}}" class="goal-strip">
      <text class="goal-strip-text">{{editableGoal}}</text>
      <button class="goal-edit-button" bindtap="startGoalEdit">需求修改</button>
    </view>
    <view wx:if="{{stage === 'direction' && isEditingGoal}}" class="goal-editor">
      <textarea
        class="goal-editor-input"
        value="{{editableGoal}}"
        maxlength="160"
        auto-height
        focus
        bindinput="onEditableGoalInput"
      />
      <view class="goal-editor-actions">
        <button class="secondary-button goal-editor-button" bindtap="cancelGoalEdit">取消</button>
        <button
          class="primary-button goal-editor-button"
          loading="{{isGoalUpdating}}"
          bindtap="applyGoalEdit"
        >确认更新</button>
      </view>
    </view>

    <view wx:if="{{stage === 'offer'}}" class="offer-context-bar">
      <view class="offer-context-copy">
        <view class="offer-context-label">正在看</view>
        <view class="offer-context-title">{{directionSummary && directionSummary.keptText ? directionSummary.keptText : '保留下来的方向'}} · 具体店铺</view>
      </view>
      <view class="offer-context-count">{{index + 1}} / {{cards.length}}</view>
    </view>

    <view class="session-strip {{stage === 'offer' ? 'offer-session-strip' : ''}}">
      <text>{{stage === 'direction' ? '方向卡' : '商家卡'}}</text>
      <view class="session-strip-right">
        <button wx:if="{{currentCard.videoUrl && !videoDisabled}}" class="sound-toggle-button" bindtap="toggleVideoMuted">{{videoMuted ? '开声音' : '静音'}}</button>
        <text>{{index + 1}} / {{cards.length}}</text>
      </view>
    </view>

    <view wx:if="{{currentCard}}" class="deck">
      <view wx:if="{{nextCard}}" class="food-card next-card">
        <image class="media" src="{{nextCard.imageUrl}}" mode="aspectFill" />
      </view>

      <view
        class="food-card current-card {{currentCard.cardType === 'offer' ? 'offer-card' : ''}}"
        style="{{cardStyle}}"
      >
        <view class="swipe-mark keep-mark" style="{{keepFeedbackStyle}}">保留</view>
        <view class="swipe-mark dislike-mark" style="{{dislikeFeedbackStyle}}">放弃</view>

        <block wx:if="{{currentCard.cardType === 'offer'}}">
          <view
            class="offer-media"
            catchtouchstart="onTouchStart"
            catchtouchmove="onTouchMove"
            catchtouchend="onTouchEnd"
          >
            <image
              wx:if="{{videoDisabled || !currentCard.videoUrl}}"
              class="offer-media-asset"
              src="{{currentImageUrl}}"
              mode="aspectFill"
              binderror="onImageError"
            />
            <video
              wx:else
              id="currentFoodVideo"
              class="offer-media-asset"
              src="{{currentCard.videoUrl}}"
              poster="{{currentPosterUrl}}"
              autoplay
              loop
              muted="{{videoMuted}}"
              object-fit="cover"
              enable-play-gesture="{{true}}"
              show-center-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              show-play-btn="{{false}}"
              controls="{{false}}"
              bindtap="toggleVideoPlay"
              bindloadedmetadata="onVideoReady"
              binderror="onVideoError"
            />
            <view class="offer-media-gradient" catchtap="toggleVideoPlay"></view>
            <cover-view wx:if="{{videoPaused}}" class="pause-badge offer-pause-badge" catchtap="toggleVideoPlay">⏸</cover-view>
          </view>

          <scroll-view
            class="offer-info"
            scroll-y
            enhanced
            show-scrollbar="{{false}}"
          >
            <view class="offer-title-row">
              <image class="offer-thumb" src="{{currentCard.coverThumbUrl}}" mode="aspectFill" binderror="onImageError" />
              <view class="offer-title-copy">
                <view class="offer-merchant">{{currentCard.title}}</view>
                <view class="offer-dish">{{currentCard.dishTitle}}</view>
              </view>
            </view>
            <view class="offer-tags">
              <text wx:for="{{currentCard.displayTags}}" wx:key="*this" class="offer-tag">{{item}}</text>
            </view>
            <view class="offer-hook">{{currentCard.subtitle}}</view>
            <view wx:if="{{currentCard.matched.length || currentCard.issueLines.length}}" class="offer-decision-block">
              <image class="offer-decision-mascot" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
              <view class="offer-decision-copy">
                <view wx:if="{{currentCard.matched.length}}" class="decision-section">
                  <view class="decision-title">小汪觉得适合主人</view>
                  <view wx:for="{{currentCard.matched}}" wx:key="*this" class="decision-line">{{item}}</view>
                </view>
                <view wx:if="{{currentCard.issueLines.length}}" class="decision-section muted-decision-section">
                  <view class="decision-title">{{currentCard.issueTitle}}</view>
                  <view wx:for="{{currentCard.issueLines}}" wx:key="*this" class="decision-line">{{item}}</view>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>

        <block wx:else>
          <view
            class="direction-swipe-surface"
            catchtouchstart="onTouchStart"
            catchtouchmove="onTouchMove"
            catchtouchend="onTouchEnd"
          >
            <image
              wx:if="{{videoDisabled || !currentCard.videoUrl}}"
              class="media"
              src="{{currentImageUrl}}"
              mode="aspectFill"
              binderror="onImageError"
            />
            <video
              wx:else
              id="currentFoodVideo"
              class="media"
              src="{{currentCard.videoUrl}}"
              poster="{{currentPosterUrl}}"
              autoplay
              loop
              muted="{{videoMuted}}"
              object-fit="cover"
              enable-play-gesture="{{true}}"
              show-center-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              show-play-btn="{{false}}"
              controls="{{false}}"
              bindtap="toggleVideoPlay"
              bindloadedmetadata="onVideoReady"
              binderror="onVideoError"
            />

            <view class="media-shade" catchtap="toggleVideoPlay"></view>
            <cover-view wx:if="{{videoPaused}}" class="pause-badge" catchtap="toggleVideoPlay">⏸</cover-view>

            <view class="card-body">
              <view class="badge">{{currentCard.badge}}</view>
              <view class="card-title">{{currentCard.title}}</view>
              <view class="card-subtitle">{{currentCard.subtitle}}</view>

              <view class="tag-row">
                <text wx:for="{{currentCard.tags}}" wx:key="*this" class="tag">{{item}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view wx:else class="empty-state">
      <view class="section-title">{{stage === 'direction' ? '方向已经滑完了' : '商户已经看完了'}}</view>
      <view class="empty-text">{{stage === 'direction' ? '可以让小汪总结一下刚刚保留和放弃的区别。' : '可以直接进入最终确认。'}}</view>
      <button
        wx:if="{{stage === 'offer'}}"
        class="primary-button full-button"
        loading="{{isLoading}}"
        bindtap="finalizeMeal"
      >进入最终确认</button>
    </view>

    <view wx:if="{{currentCard}}" class="action-bar {{stage === 'offer' ? 'offer-action-bar' : ''}}">
      <button class="round-button dislike-button" bindtap="onDislike" disabled="{{!currentCard || isLoading}}">×</button>
      <button
        wx:if="{{stage === 'direction'}}"
        class="middle-button"
        bindtap="loadDirectionSummary"
        loading="{{isLoading}}"
        disabled="{{isLoading || !sessionId}}"
      >看小结</button>
      <button
        wx:else
        class="middle-button"
        bindtap="chooseCurrentOffer"
        loading="{{isLoading}}"
        disabled="{{!currentCard || isLoading}}"
      >就这家</button>
      <button class="round-button keep-button" bindtap="onKeep" disabled="{{!currentCard || isLoading}}">✓</button>
    </view>
  </view>

  <view wx:elif="{{stage === 'direction_summary' || stage === 'direction_summary_loading'}}" class="summary-panel">
    <image class="summary-mascot" src="{{xiaowangSummaryUrl}}" mode="aspectFit" />
    <view class="section-title">小汪先帮主人收窄一下</view>
    <view wx:if="{{directionSummary}}" class="summary-choice-block">
      <view class="summary-choice-line">主人保留了 {{directionSummary.keptText}}。</view>
      <view class="summary-choice-line">先避开：{{directionSummary.dislikedText}}。</view>
    </view>
    <view wx:if="{{directionSummary && (directionSummary.text || directionSummary.intentText)}}" class="summary-highlight">
      {{directionSummary.text || directionSummary.intentText}}
    </view>
    <view wx:else class="summary-text">{{loadingText || '正在整理这轮选择...'}}</view>
    <view wx:if="{{directionSummary}}" class="summary-feedback">
      <view class="summary-feedback-title">小汪理解对了吗？</view>
      <view class="summary-feedback-actions">
        <button class="mini-feedback-button" bindtap="markDirectionSummaryOk">差不多</button>
        <button class="mini-feedback-button" bindtap="openDirectionCorrectionInput">补充一句</button>
      </view>
      <view wx:if="{{summaryCorrectionOpen}}" class="summary-correction-box">
        <input
          class="summary-correction-input"
          value="{{summaryCorrectionText}}"
          placeholder="比如：其实我更想快一点吃完"
          bindinput="onDirectionCorrectionInput"
        />
        <button class="summary-correction-submit" bindtap="applyDirectionCorrection">应用</button>
      </view>
      <view wx:if="{{directionCorrectionNotice}}" class="summary-feedback-notice">{{directionCorrectionNotice}}</view>
    </view>
    <view class="summary-actions">
      <button class="secondary-button" bindtap="resetFlow">重新开始</button>
      <button class="primary-button inline-button" loading="{{isLoading}}" bindtap="continueToOffers">看具体商家</button>
    </view>
  </view>

  <view wx:elif="{{stage === 'final'}}" class="final-panel">
    <view wx:if="{{result.hasSelection}}">
      <view class="final-kicker">最终确认</view>
      <view class="section-title final-title">小汪建议这一家</view>
      <view class="result-ai-row">
        <image class="result-ai-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
        <view class="result-ai-copy">{{result.summaryText}}</view>
      </view>
      <view class="result-card">
        <image class="result-image" src="{{result.primary.imageUrl}}" mode="aspectFill" />
        <view class="result-content">
          <view class="result-merchant">{{result.primary.title}}</view>
          <view class="dish-title dark-dish">{{result.primary.dishTitle}}</view>
          <view class="tag-row fixed-tags">
            <text wx:for="{{result.primary.tags}}" wx:key="*this" class="tag dark-tag">{{item}}</text>
          </view>
          <view wx:if="{{result.primary.matched.length}}" class="result-reason-block">
            <view class="result-mini-title">为什么是这家</view>
            <view wx:for="{{result.primary.matched}}" wx:key="*this" class="result-reason-line">{{item}}</view>
          </view>
          <view wx:if="{{result.primary.issueLines.length}}" class="result-reason-block result-watchout-block">
            <view class="result-mini-title">{{result.primary.issueTitle}}</view>
            <view wx:for="{{result.primary.issueLines}}" wx:key="*this" class="result-reason-line">{{item}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{result.alternatives.length}}" class="alt-list">
        <view class="mini-title">备选</view>
        <view wx:for="{{result.alternatives}}" wx:key="cardId" class="alt-item">
          <text>{{item.title}}</text>
          <text>{{item.dishTitle}}</text>
        </view>
      </view>

      <view class="feedback-panel">
        <view class="field-label">吃完以后告诉小汪真实感受</view>
        <textarea
          class="feedback-textarea"
          value="{{postMealFeedbackText}}"
          maxlength="180"
          bindinput="onFeedbackInput"
          placeholder="比如：这家面很好吃，但环境有点吵。"
        />
        <button class="primary-button" loading="{{isLoading}}" bindtap="submitPostMealFeedback">提交反馈</button>
        <view wx:if="{{postMealResponse}}" class="notice feedback-notice">
          已记录反馈，生成 {{postMealResponse.createdCount}} 条待确认记忆。
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <view class="section-title">这轮还没选出明确商家</view>
      <view class="empty-text">可以重新开始，或者多保留几张商户卡。</view>
    </view>
    <button class="secondary-button full-button" bindtap="resetFlow">再来一轮</button>
  </view>

  <view wx:if="{{isLoading}}" class="loading-mask">
    <view class="loading-box">
      <view class="loader"></view>
      <view>{{loadingText}}</view>
    </view>
  </view>

  <view class="debug-strip">
    <text>API {{sessionDebug.api}}</text>
    <text>{{sessionDebug.mode}}</text>
    <text>{{sessionDebug.memory}}</text>
  </view>
</view>
