<view class="page {{activeTab === 'chat' ? 'chat-page' : ''}}">
  <view wx:if="{{activeTab !== 'chat'}}" class="topbar">
    <view>
      <text class="brand">饭点定了</text>
    </view>
    <view wx:if="{{stage !== 'entry'}}" class="status-pill">{{stageSubtitle}}</view>
  </view>

  <view wx:if="{{bootNotice}}" class="notice">{{bootNotice}}</view>
  <view wx:if="{{errorText}}" class="error">{{errorText}}</view>

  <view wx:if="{{activeTab === 'meal' && stage === 'entry'}}" class="entry-panel">
    <view class="entry-title-row">
      <view class="section-title entry-title">今天想怎么吃？</view>
      <button class="location-chip" bindtap="getLocation">{{locationText}}</button>
    </view>
    <view class="xiaowang-card">
      <image class="xiaowang-mascot" src="{{xiaowangMascotUrl}}" mode="aspectFit" />
      <view class="xiaowang-copy">
        <view class="xiaowang-name">小汪</view>
        <view class="xiaowang-line">先选几项，也可以直接把今天的想法告诉我。</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">人数</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.partySize}}"
          wx:key="value"
          class="option-pill {{entryForm.partySize === item.value ? 'active' : ''}}"
          data-field="partySize"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="budget-head">
        <view class="field-label">预算</view>
        <view class="budget-value">{{entryForm.budget === '500' ? '先不限制' : entryForm.budget + ' 元以内'}}</view>
      </view>
      <slider
        class="budget-slider"
        min="0"
        max="500"
        step="10"
        value="{{entryForm.budget}}"
        activeColor="#ff6334"
        backgroundColor="rgba(125, 78, 44, 0.14)"
        block-color="#ff6334"
        block-size="24"
        bindchanging="onBudgetChange"
        bindchange="onBudgetChange"
      />
      <view class="budget-scale">
        <text>0</text>
        <text>250</text>
        <text>不限</text>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">距离</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.radius}}"
          wx:key="value"
          class="option-pill {{entryForm.radius === item.value ? 'active' : ''}}"
          data-field="radius"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">口味</view>
      <view class="option-row">
        <button
          wx:for="{{entryOptions.flavor}}"
          wx:key="value"
          class="option-pill {{entryForm.flavor === item.value ? 'active' : ''}}"
          data-field="flavor"
          data-value="{{item.value}}"
          bindtap="selectEntryOption"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="field-block">
      <view class="field-label">今天想怎么吃</view>
      <textarea
        class="entry-textarea"
        value="{{entryForm.text}}"
        maxlength="160"
        bindinput="onEntryTextInput"
        placeholder="比如：今天下班有点累，想吃点热乎下饭的。"
      />
    </view>

    <view class="entry-actions">
      <button
        wx:if="{{resumableSessionId}}"
        class="secondary-button entry-secondary"
        loading="{{isLoading}}"
        bindtap="restoreSession"
      >继续上次</button>
      <button class="primary-button entry-primary" loading="{{isLoading}}" bindtap="startMealFlow">开始新一轮</button>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'meal' && (stage === 'direction' || stage === 'offer')}}" class="flow {{stage === 'offer' ? 'offer-flow' : ''}}">
    <view wx:if="{{stage === 'direction'}}" class="direction-brief">
      <image class="direction-brief-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
      <view class="direction-brief-copy">先滑几张方向卡，喜欢的留下，不喜欢的划走，后面再看具体店。</view>
    </view>
    <view wx:if="{{stage === 'direction' && !isEditingGoal}}" class="goal-strip">
      <text class="goal-strip-text">{{editableGoal}}</text>
      <button class="goal-edit-button" bindtap="startGoalEdit">需求修改</button>
    </view>
    <view wx:if="{{stage === 'direction' && isEditingGoal}}" class="goal-editor">
      <textarea
        class="goal-editor-input"
        value="{{editableGoal}}"
        maxlength="160"
        auto-height
        focus
        bindinput="onEditableGoalInput"
      />
      <view class="goal-editor-actions">
        <button class="secondary-button goal-editor-button" bindtap="cancelGoalEdit">取消</button>
        <button
          class="primary-button goal-editor-button"
          loading="{{isGoalUpdating}}"
          bindtap="applyGoalEdit"
        >确认更新</button>
      </view>
    </view>

    <view wx:if="{{stage === 'offer'}}" class="offer-context-bar">
      <view class="offer-context-copy">
        <view class="offer-context-label">正在看</view>
        <view class="offer-context-title">{{directionSummary && directionSummary.keptText ? directionSummary.keptText : '保留下来的方向'}} · 具体店铺</view>
      </view>
      <view class="offer-context-count">{{index + 1}} / {{cards.length}}</view>
    </view>

    <view class="session-strip {{stage === 'offer' ? 'offer-session-strip' : ''}}">
      <text>{{stage === 'direction' ? '方向卡' : '商家卡'}}</text>
      <view class="session-strip-right">
        <button wx:if="{{currentCard.videoUrl && !videoDisabled}}" class="sound-toggle-button" bindtap="toggleVideoMuted">{{videoMuted ? '开声音' : '静音'}}</button>
        <text>{{index + 1}} / {{cards.length}}</text>
      </view>
    </view>

    <view wx:if="{{currentCard}}" class="deck">
      <view wx:if="{{nextCard}}" class="food-card next-card">
        <image class="media" src="{{nextCard.imageUrl}}" mode="aspectFill" />
      </view>

      <view
        class="food-card current-card {{currentCard.cardType === 'offer' ? 'offer-card' : ''}}"
        style="{{cardStyle}}"
      >
        <view class="swipe-mark keep-mark" style="{{keepFeedbackStyle}}">保留</view>
        <view class="swipe-mark dislike-mark" style="{{dislikeFeedbackStyle}}">放弃</view>

        <block wx:if="{{currentCard.cardType === 'offer'}}">
          <view
            class="offer-media"
            catchtouchstart="onTouchStart"
            catchtouchmove="onTouchMove"
            catchtouchend="onTouchEnd"
          >
            <block wx:if="{{videoDisabled || !currentCard.videoUrl}}">
              <image
                class="offer-media-asset"
                src="{{currentImageUrl}}"
                mode="aspectFill"
                binderror="onImageError"
              />
            </block>
            <video
              wx:else
              id="currentFoodVideo"
              class="offer-media-asset"
              src="{{currentCard.videoUrl}}"
              poster="{{currentPosterUrl}}"
              autoplay
              loop
              muted="{{videoMuted}}"
              object-fit="cover"
              enable-play-gesture="{{true}}"
              show-center-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              show-play-btn="{{false}}"
              controls="{{false}}"
              bindtap="toggleVideoPlay"
              bindloadedmetadata="onVideoReady"
              binderror="onVideoError"
            />
            <cover-view wx:if="{{!videoDisabled && currentCard.videoSources.length > 1}}" class="offer-video-source-switch">
              <cover-view
                wx:for="{{currentCard.videoSources}}"
                wx:key="key"
                class="offer-video-source-pill {{currentCard.activeVideoIndex === index ? 'active' : ''}}"
                data-index="{{index}}"
                bindtap="switchOfferVideoSource"
              >{{item.label}}</cover-view>
            </cover-view>
            <cover-view wx:if="{{!videoDisabled && currentCard.danmaku.length}}" class="offer-danmaku-layer">
              <cover-view
                wx:for="{{currentCard.danmaku}}"
                wx:key="text"
                class="offer-danmaku-item danmaku-row-{{item.row}}"
                style="animation-duration: {{item.duration}}s; animation-delay: {{item.delay}}s;"
              >{{item.text}}</cover-view>
            </cover-view>
            <view class="offer-media-gradient" catchtap="toggleVideoPlay"></view>
            <cover-view wx:if="{{videoPaused}}" class="pause-badge offer-pause-badge" catchtap="toggleVideoPlay">⏸</cover-view>
          </view>

          <scroll-view
            class="offer-info"
            scroll-y
            enhanced
            show-scrollbar="{{false}}"
          >
            <button
              wx:if="{{currentCard.hasGalleryImages && currentCard.galleryImages.length > 1}}"
              class="offer-gallery-button"
              bindtap="previewOfferGallery"
            >相册 {{currentCard.galleryImages.length}} 张</button>
            <view class="offer-title-row">
              <image class="offer-thumb" src="{{currentCard.coverThumbUrl}}" mode="aspectFill" binderror="onImageError" />
              <view class="offer-title-copy">
                <view class="offer-merchant">{{currentCard.title}}</view>
                <view class="offer-dish">{{currentCard.dishTitle}}</view>
              </view>
            </view>
            <view class="offer-tags">
              <text wx:for="{{currentCard.displayTags}}" wx:key="*this" class="offer-tag">{{item}}</text>
            </view>
            <view class="offer-hook">{{currentCard.subtitle}}</view>
            <view wx:if="{{currentCard.matched.length || currentCard.issueLines.length}}" class="offer-decision-block">
              <image class="offer-decision-mascot" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
              <view class="offer-decision-copy">
                <view wx:if="{{currentCard.matched.length}}" class="decision-section">
                  <view class="decision-title">小汪觉得适合主人</view>
                  <view wx:for="{{currentCard.matched}}" wx:key="*this" class="decision-line">{{item}}</view>
                </view>
                <view wx:if="{{currentCard.issueLines.length}}" class="decision-section muted-decision-section">
                  <view class="decision-title">{{currentCard.issueTitle}}</view>
                  <view wx:for="{{currentCard.issueLines}}" wx:key="*this" class="decision-line">{{item}}</view>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>

        <block wx:else>
          <view
            class="direction-swipe-surface"
            catchtouchstart="onTouchStart"
            catchtouchmove="onTouchMove"
            catchtouchend="onTouchEnd"
          >
            <image
              wx:if="{{videoDisabled || !currentCard.videoUrl}}"
              class="media"
              src="{{currentImageUrl}}"
              mode="aspectFill"
              binderror="onImageError"
            />
            <video
              wx:else
              id="currentFoodVideo"
              class="media"
              src="{{currentCard.videoUrl}}"
              poster="{{currentPosterUrl}}"
              autoplay
              loop
              muted="{{videoMuted}}"
              object-fit="cover"
              enable-play-gesture="{{true}}"
              show-center-play-btn="{{false}}"
              show-fullscreen-btn="{{false}}"
              show-play-btn="{{false}}"
              controls="{{false}}"
              bindtap="toggleVideoPlay"
              bindloadedmetadata="onVideoReady"
              binderror="onVideoError"
            />

            <view class="media-shade" catchtap="toggleVideoPlay"></view>
            <cover-view wx:if="{{videoPaused}}" class="pause-badge" catchtap="toggleVideoPlay">⏸</cover-view>

            <view class="card-body">
              <view class="badge">{{currentCard.badge}}</view>
              <view class="card-title">{{currentCard.title}}</view>
              <view class="card-subtitle">{{currentCard.subtitle}}</view>

              <view class="tag-row">
                <text wx:for="{{currentCard.tags}}" wx:key="*this" class="tag">{{item}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view wx:else class="empty-state">
      <view class="section-title">{{stage === 'direction' ? '方向已经滑完了' : '商户已经看完了'}}</view>
      <view class="empty-text">{{stage === 'direction' ? '可以让小汪总结一下刚刚保留和放弃的区别。' : '可以直接进入最终确认。'}}</view>
      <button
        wx:if="{{stage === 'offer'}}"
        class="primary-button full-button"
        loading="{{isLoading}}"
        bindtap="finalizeMeal"
      >进入最终确认</button>
    </view>

    <view wx:if="{{currentCard}}" class="action-bar {{stage === 'offer' ? 'offer-action-bar' : ''}}">
      <button class="round-button dislike-button" bindtap="onDislike" disabled="{{!currentCard || isLoading}}">×</button>
      <button
        wx:if="{{stage === 'direction'}}"
        class="middle-button"
        bindtap="loadDirectionSummary"
        loading="{{isLoading}}"
        disabled="{{isLoading || !sessionId}}"
      >看小结</button>
      <button
        wx:else
        class="middle-button"
        bindtap="chooseCurrentOffer"
        loading="{{isLoading}}"
        disabled="{{!currentCard || isLoading}}"
      >就这家</button>
      <button class="round-button keep-button" bindtap="onKeep" disabled="{{!currentCard || isLoading}}">✓</button>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'meal' && (stage === 'direction_summary' || stage === 'direction_summary_loading')}}" class="summary-panel">
    <image class="summary-mascot" src="{{xiaowangSummaryUrl}}" mode="aspectFit" />
    <view class="section-title">小汪先帮主人收窄一下</view>
    <view wx:if="{{directionSummary}}" class="summary-choice-block">
      <view class="summary-choice-line">主人保留了 {{directionSummary.keptText}}。</view>
      <view class="summary-choice-line">先避开：{{directionSummary.dislikedText}}。</view>
    </view>
    <view wx:if="{{directionSummary && (directionSummary.text || directionSummary.intentText)}}" class="summary-highlight">
      {{directionSummary.text || directionSummary.intentText}}
    </view>
    <view wx:else class="summary-text">{{loadingText || '正在整理这轮选择...'}}</view>
    <view wx:if="{{directionSummary}}" class="summary-feedback">
      <view class="summary-feedback-title">小汪理解对了吗？</view>
      <view class="summary-feedback-actions">
        <button class="mini-feedback-button" bindtap="markDirectionSummaryOk">差不多</button>
        <button class="mini-feedback-button" bindtap="openDirectionCorrectionInput">补充一句</button>
      </view>
      <view wx:if="{{summaryCorrectionOpen}}" class="summary-correction-box">
        <input
          class="summary-correction-input"
          value="{{summaryCorrectionText}}"
          placeholder="比如：其实我更想快一点吃完"
          bindinput="onDirectionCorrectionInput"
        />
        <button class="summary-correction-submit" bindtap="applyDirectionCorrection">应用</button>
      </view>
      <view wx:if="{{directionCorrectionNotice}}" class="summary-feedback-notice">{{directionCorrectionNotice}}</view>
    </view>
    <view class="summary-actions">
      <button class="secondary-button" bindtap="resetFlow">重新开始</button>
      <button class="primary-button inline-button" loading="{{isLoading}}" bindtap="continueToOffers">看具体商家</button>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'meal' && stage === 'final'}}" class="final-panel">
    <view wx:if="{{result.hasSelection}}">
      <view class="final-kicker">最终确认</view>
      <view class="section-title final-title">小汪建议这一家</view>
      <view class="result-ai-row">
        <image class="result-ai-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
        <view class="result-ai-copy">{{result.summaryText}}</view>
      </view>
      <view class="result-card">
        <image class="result-image" src="{{result.primary.imageUrl}}" mode="aspectFill" />
        <view class="result-content">
          <view class="result-merchant">{{result.primary.title}}</view>
          <view class="dish-title dark-dish">{{result.primary.dishTitle}}</view>
          <view class="tag-row fixed-tags">
            <text wx:for="{{result.primary.tags}}" wx:key="*this" class="tag dark-tag">{{item}}</text>
          </view>
          <view wx:if="{{result.primary.matched.length}}" class="result-reason-block">
            <view class="result-mini-title">为什么是这家</view>
            <view wx:for="{{result.primary.matched}}" wx:key="*this" class="result-reason-line">{{item}}</view>
          </view>
          <view wx:if="{{result.primary.issueLines.length}}" class="result-reason-block result-watchout-block">
            <view class="result-mini-title">{{result.primary.issueTitle}}</view>
            <view wx:for="{{result.primary.issueLines}}" wx:key="*this" class="result-reason-line">{{item}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{result.alternatives.length}}" class="alt-list">
        <view class="mini-title">备选</view>
        <view wx:for="{{result.alternatives}}" wx:key="cardId" class="alt-item">
          <text>{{item.title}}</text>
          <text>{{item.dishTitle}}</text>
        </view>
      </view>

      <view class="feedback-panel">
        <view class="field-label">吃完以后告诉小汪真实感受</view>
        <textarea
          class="feedback-textarea"
          value="{{postMealFeedbackText}}"
          maxlength="180"
          bindinput="onFeedbackInput"
          placeholder="比如：这家面很好吃，但环境有点吵。"
        />
        <button class="primary-button" loading="{{isLoading}}" bindtap="submitPostMealFeedback">提交反馈</button>
        <view wx:if="{{postMealResponse}}" class="notice feedback-notice">
          已记录反馈，生成 {{postMealResponse.createdCount}} 条待确认记忆。
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <view class="section-title">这轮还没选出明确商家</view>
      <view class="empty-text">可以重新开始，或者多保留几张商户卡。</view>
    </view>
    <button class="secondary-button full-button" bindtap="resetFlow">再来一轮</button>
  </view>

  <view wx:elif="{{activeTab === 'chat'}}" class="chat-panel">
    <scroll-view class="chat-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="chat-time">今天</view>
      <view class="chat-message-row assistant-row">
        <image class="chat-message-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
        <view class="chat-message-stack">
          <view class="chat-sender">小汪</view>
          <view class="chat-bubble assistant-bubble">我在。把今天的状态告诉我；需要做决定时，我可以直接调起饭点滑卡。</view>
        </view>
      </view>
      <view class="chat-message-row assistant-row skill-message-row">
        <image class="chat-message-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
        <view class="chat-message-stack full-stack">
          <view class="skill-launcher">
            <view class="skill-launcher-copy">
              <view class="skill-launcher-title">今天不知道吃什么？</view>
              <view class="skill-launcher-desc">先走方向，再筛具体店。</view>
            </view>
            <button class="skill-launcher-button" bindtap="startMealSkill">直接帮我选</button>
          </view>
        </view>
      </view>
      <view
        wx:for="{{chatMessages}}"
        wx:key="id"
        class="chat-message-row {{item.role === 'user' ? 'user-row' : 'assistant-row'}}"
      >
        <image wx:if="{{item.role !== 'user'}}" class="chat-message-avatar" src="{{xiaowangHeadUrl}}" mode="aspectFit" />
        <view class="chat-message-stack {{item.role === 'user' ? 'user-stack' : ''}}">
          <view wx:if="{{item.role !== 'user'}}" class="chat-sender">小汪</view>
          <view class="chat-bubble {{item.role === 'user' ? 'user-bubble' : 'assistant-bubble'}} {{item.isThinking ? 'thinking-bubble' : ''}}">
            <block wx:if="{{item.isThinking}}">
              <text>{{item.content}}</text>
              <text class="thinking-dot">.</text>
              <text class="thinking-dot second-dot">.</text>
              <text class="thinking-dot third-dot">.</text>
            </block>
            <block wx:else>{{item.content}}</block>
          </view>
          <view wx:if="{{item.debug_trace}}" class="agent-trace">
            <view class="agent-trace-head">
              <text class="agent-trace-dot"></text>
              <text>开发轨迹</text>
            </view>
            <view class="agent-trace-lines">
              <text wx:for="{{item.debug_trace.lines}}" wx:key="*this" class="agent-trace-line">{{item}}</text>
            </view>
          </view>
          <view wx:if="{{item.skill_cards && item.skill_cards.length}}" class="skill-card-list">
            <view wx:for="{{item.skill_cards}}" wx:for-item="skill" wx:key="skill" class="skill-card">
              <view class="skill-card-copy">
                <view class="skill-card-title">{{skill.title}}</view>
                <view class="skill-card-desc">{{skill.description}}</view>
              </view>
              <button class="skill-card-button" data-action="{{skill.action}}" bindtap="runChatSkill">{{skill.cta}}</button>
            </view>
          </view>
          <view wx:if="{{item.skill_result_cards && item.skill_result_cards.length}}" class="skill-result-list">
            <view wx:for="{{item.skill_result_cards}}" wx:for-item="result" wx:key="title" class="skill-result-card">
              <block wx:if="{{result.isDealCard}}">
                <view wx:if="{{result.poster_url || result.image_url}}" class="deal-poster-wrap">
                  <image class="deal-poster" src="{{result.poster_url || result.image_url}}" mode="aspectFill" binderror="onImageError" />
                </view>
                <view class="deal-simple-body">
                  <view class="deal-shop-name">{{result.merchant_name || result.title}}</view>
                  <view wx:if="{{result.discount_text || result.deal_price_text}}" class="deal-simple-offer">
                    <text wx:if="{{result.discount_text}}" class="deal-discount-pill">{{result.discount_text}}</text>
                    <text wx:if="{{result.deal_price_text}}" class="deal-simple-price">{{result.deal_price_text}}</text>
                  </view>
                  <view wx:if="{{result.menu_text}}" class="deal-menu-line">可吃：{{result.menu_text}}</view>
                  <view wx:if="{{result.recommendation}}" class="deal-recommendation">{{result.recommendation}}</view>
                </view>
              </block>
              <block wx:else>
                <view class="skill-result-title">{{result.title}}</view>
                <view wx:if="{{result.subtitle}}" class="skill-result-subtitle">{{result.subtitle}}</view>
                <view wx:if="{{result.summary}}" class="skill-result-summary">{{result.summary}}</view>
                <view wx:if="{{result.primary_points && result.primary_points.length}}" class="skill-result-points">
                  <view wx:for="{{result.primary_points}}" wx:for-item="point" wx:key="*this" class="skill-result-point">{{point}}</view>
                </view>
                <view wx:if="{{result.evidence_chips && result.evidence_chips.length}}" class="evidence-chip-list">
                  <view wx:for="{{result.evidence_chips}}" wx:for-item="chip" wx:key="label" class="evidence-chip">
                    <text>{{chip.label}}</text>
                    <text wx:if="{{chip.value}}" class="evidence-chip-value">{{chip.value}}</text>
                  </view>
                </view>
                <view wx:if="{{result.merchants && result.merchants.length}}" class="compare-merchant-list">
                  <view wx:for="{{result.merchants}}" wx:for-item="merchant" wx:key="merchant_id" class="compare-merchant">
                    <view class="compare-merchant-head">
                      <text class="compare-merchant-name">{{merchant.name}}</text>
                      <text class="compare-merchant-rating">{{merchant.rating}}</text>
                    </view>
                    <view wx:if="{{merchant.scene}}" class="compare-merchant-scene">{{merchant.scene}}</view>
                    <view wx:if="{{merchant.specialtiesText}}" class="compare-merchant-tags">招牌：{{merchant.specialtiesText}}</view>
                    <view wx:if="{{merchant.tags && merchant.tags.length}}" class="compare-evidence-row">
                      <text wx:for="{{merchant.tags}}" wx:for-item="tag" wx:key="label" class="compare-evidence-chip">{{tag.label}} {{tag.value}}</text>
                    </view>
                  </view>
                </view>
                <view wx:if="{{result.note}}" class="skill-result-note">{{result.note}}</view>
              </block>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="chat-input-row">
      <textarea
        class="chat-input"
        value="{{chatInput}}"
        maxlength="160"
        auto-height
        bindinput="onChatInput"
        placeholder="比如：帮我走滑卡，今天想吃热乎一点。"
      />
      <button class="chat-send-button" loading="{{isChatSubmitting}}" bindtap="submitXiaowangChat">发送</button>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'diary'}}" class="diary-panel">
    <view class="diary-head">
      <view>
        <view class="section-title diary-title">小汪日记本</view>
        <view class="diary-subtitle">主人今天怎么挑饭、哪里犹豫、哪些偏好值得记住，小汪都会慢慢攒起来。</view>
      </view>
      <view class="diary-head-actions">
        <button class="diary-refresh" loading="{{isDreaming}}" bindtap="runXiaowangDreaming">复盘</button>
        <button class="diary-refresh" loading="{{isDiaryLoading}}" bindtap="loadXiaowangDiary">刷新</button>
      </view>
    </view>

    <view wx:if="{{diaryError}}" class="error">{{diaryError}}</view>

    <view wx:if="{{diary && diary.daily_summary}}" class="diary-summary-card">
      <view class="diary-summary-label">小汪今天看到</view>
      <view class="diary-summary-text">{{diary.daily_summary.text}}</view>
      <view wx:if="{{diary.daily_summary.next_prompt}}" class="diary-summary-next">{{diary.daily_summary.next_prompt}}</view>
    </view>

    <view class="diary-section">
      <view class="mini-title">今天吃饭记录</view>
      <view wx:if="{{diary && diary.meal_sessions && diary.meal_sessions.length}}">
        <view wx:for="{{diary.meal_sessions}}" wx:key="session_id" class="diary-item">
          <view class="diary-item-meta">
            <text>{{item.display_date}}</text>
            <text>{{item.display_time}}</text>
            <text>{{item.diary_status}}</text>
          </view>
          <view class="diary-item-title">{{item.diary_title}}</view>
          <view class="diary-item-text">{{item.diary_text}}</view>
        </view>
      </view>
      <view wx:else class="diary-empty">今天小汪还没陪主人认真挑过饭。等你开始一轮，我就把过程记下来。</view>
    </view>

    <view class="diary-section">
      <view class="mini-title">小汪想确认</view>
      <view wx:if="{{diary && diary.memory_candidates && diary.memory_candidates.length}}">
        <view wx:for="{{diary.memory_candidates}}" wx:key="candidate_id" class="memory-candidate">
          <view class="diary-item-meta">
            <text>{{item.display_date}}</text>
            <text>{{item.display_time}}</text>
            <text>待确认</text>
          </view>
          <view class="memory-candidate-text">{{item.diary_text}}</view>
          <view wx:if="{{editingMemoryCandidateId === item.candidate_id}}" class="memory-edit-box">
            <textarea
              class="memory-edit-input"
              value="{{memoryEditText}}"
              maxlength="120"
              auto-height
              bindinput="onMemoryEditInput"
            />
          </view>
          <view class="memory-candidate-actions">
            <button class="memory-skip-button" data-id="{{item.candidate_id}}" bindtap="rejectDiaryCandidate">先不记</button>
            <button
              wx:if="{{editingMemoryCandidateId !== item.candidate_id}}"
              class="memory-skip-button"
              data-id="{{item.candidate_id}}"
              data-text="{{item.confirmation_text || item.statement}}"
              bindtap="startEditDiaryCandidate"
            >改一下</button>
            <button
              wx:else
              class="memory-skip-button"
              bindtap="cancelEditDiaryCandidate"
            >取消</button>
            <button class="memory-confirm-button" data-id="{{item.candidate_id}}" bindtap="confirmDiaryCandidate">记住</button>
          </view>
        </view>
      </view>
      <view wx:else class="diary-empty">暂时没有需要主人确认的长期记忆。</view>
    </view>

    <view class="diary-section">
      <view class="mini-title">已经记住</view>
      <view wx:if="{{diary && diary.confirmed_preferences && diary.confirmed_preferences.length}}" class="preference-list">
        <view wx:for="{{diary.confirmed_preferences}}" wx:key="preference_id" class="preference-pill">
          <view>{{item.diary_text}}</view>
          <view wx:if="{{item.display_date}}" class="preference-time">{{item.display_date}} {{item.display_time}}</view>
        </view>
      </view>
      <view wx:else class="diary-empty">主人点过“记住”以后，小汪会把长期偏好收在这里，之后挑饭会更懂你。</view>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="loading-mask">
    <view class="loading-box">
      <view class="loader"></view>
      <view>{{loadingText}}</view>
    </view>
  </view>

  <view class="main-tabs">
    <button class="main-tab {{activeTab === 'chat' ? 'main-tab-active' : ''}}" data-tab="chat" bindtap="switchMainTab">
      <view class="main-tab-icon">汪</view>
      <view class="main-tab-label">问小汪</view>
    </button>
    <button class="main-tab {{activeTab === 'meal' ? 'main-tab-active' : ''}}" data-tab="meal" bindtap="switchMainTab">
      <view class="main-tab-icon">饭</view>
      <view class="main-tab-label">挑饭</view>
    </button>
    <button class="main-tab {{activeTab === 'diary' ? 'main-tab-active' : ''}}" data-tab="diary" bindtap="switchMainTab">
      <view class="main-tab-icon">记</view>
      <view class="main-tab-label">汪记本</view>
    </button>
  </view>

  <view class="debug-strip">
    <text>API {{sessionDebug.api}}</text>
    <text>{{sessionDebug.mode}}</text>
    <text>{{sessionDebug.memory}}</text>
  </view>
</view>
