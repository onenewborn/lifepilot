page {
  min-height: 100%;
  background: #fff2dc;
  color: #2d2118;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  border: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff4df 0%, #ffe9c7 48%, #f8dcb4 100%);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.brand {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
  color: #2d2118;
}

.stage {
  display: block;
  margin-top: 4rpx;
  color: rgba(75, 50, 31, 0.68);
  font-size: 24rpx;
}

.status-pill {
  max-width: 320rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.62);
  color: rgba(55, 35, 22, 0.9);
  box-shadow: inset 0 0 0 1rpx rgba(125, 78, 44, 0.14);
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.notice,
.error {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.notice {
  background: rgba(255, 255, 255, 0.62);
  color: rgba(75, 50, 31, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(125, 78, 44, 0.1);
}

.error {
  background: #fde8e5;
  color: #a3342b;
}

.entry-panel,
.summary-panel,
.final-panel {
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 250, 240, 0.96);
  box-shadow: 0 20rpx 44rpx rgba(142, 92, 43, 0.16);
  border: 1rpx solid rgba(125, 78, 44, 0.12);
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #2d2118;
}

.xiaowang-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 142rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.xiaowang-mascot {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}

.xiaowang-copy {
  flex: 1;
  min-width: 0;
}

.xiaowang-name {
  color: #2d2118;
  font-size: 30rpx;
  font-weight: 900;
}

.xiaowang-line {
  margin-top: 8rpx;
  color: rgba(75, 50, 31, 0.68);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: rgba(75, 50, 31, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.option-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 14rpx;
}

.option-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 66rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: rgba(45, 33, 24, 0.84);
  font-size: 25rpx;
  line-height: 66rpx;
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
  white-space: nowrap;
}

.option-pill.active {
  background: #ff6334;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(255, 99, 52, 0.24);
}

.budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.budget-value {
  flex-shrink: 0;
  color: #ff6334;
  font-size: 25rpx;
  font-weight: 900;
}

.budget-slider {
  margin: 4rpx 0 0;
}

.budget-scale {
  display: flex;
  justify-content: space-between;
  margin-top: -8rpx;
  color: rgba(75, 50, 31, 0.48);
  font-size: 20rpx;
  font-weight: 800;
}

.entry-textarea,
.feedback-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #1f2428;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.compact-location {
  margin: 24rpx 0 20rpx;
  padding: 16rpx 18rpx;
}

.top-location {
  margin-top: 18rpx;
}

.location-text {
  color: rgba(45, 33, 24, 0.84);
  font-size: 24rpx;
}

.primary-button,
.secondary-button,
.ghost-button,
.middle-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  background: #ff6334;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(255, 99, 52, 0.24);
}

.entry-actions {
  display: flex;
  gap: 14rpx;
}

.entry-secondary {
  flex: 0 0 220rpx;
}

.entry-primary {
  flex: 1;
}

.secondary-button {
  width: 220rpx;
  background: rgba(255, 255, 255, 0.8);
  color: rgba(45, 33, 24, 0.84);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.ghost-button {
  width: 132rpx;
  height: 62rpx;
  background: #ffffff;
  color: #ff6334;
  font-size: 24rpx;
  line-height: 62rpx;
}

.flow {
  min-height: 900rpx;
}

.session-strip {
  display: flex;
  justify-content: space-between;
  margin: 8rpx 0 18rpx;
  color: #667078;
  font-size: 24rpx;
  font-weight: 700;
}

.deck {
  position: relative;
  width: 100%;
  height: 930rpx;
}

.food-card {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  height: 900rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #1f2428;
  box-shadow: 0 26rpx 56rpx rgba(31, 36, 40, 0.18);
}

.next-card {
  top: 24rpx;
  transform: scale(0.95);
  opacity: 0.55;
}

.current-card {
  top: 0;
  z-index: 2;
}

.media {
  width: 100%;
  height: 100%;
}

.media-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(31, 36, 40, 0) 0%, rgba(31, 36, 40, 0.78) 42%, rgba(31, 36, 40, 0.95) 100%);
}

.sound-button {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  z-index: 4;
  width: 96rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #1f2428;
  font-size: 22rpx;
  font-weight: 800;
}

.card-body {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 3;
  color: #ffffff;
}

.badge {
  display: inline-flex;
  max-width: 100%;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  line-height: 1.3;
}

.card-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
  word-break: break-word;
}

.dish-title {
  margin-top: 8rpx;
  color: #ffd68d;
  font-size: 28rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  max-width: 100%;
  padding: 9rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.35;
}

.offer-detail,
.direction-detail {
  margin-top: 18rpx;
}

.fact-line,
.reason-line {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.45;
}

.mini-title {
  margin-top: 16rpx;
  color: #ffd68d;
  font-size: 23rpx;
  font-weight: 900;
}

.muted-title,
.muted-line,
.muted-block .reason-line {
  color: rgba(255, 255, 255, 0.68);
}

.swipe-mark {
  position: absolute;
  top: 56rpx;
  z-index: 5;
  padding: 14rpx 20rpx;
  border: 5rpx solid currentColor;
  border-radius: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
  opacity: 0;
}

.keep-mark {
  right: 46rpx;
  color: #47d18c;
  transform: rotate(12deg);
}

.dislike-mark {
  left: 46rpx;
  color: #ff746c;
  transform: rotate(-12deg);
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 4rpx;
}

.round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: #ffffff;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 116rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(31, 36, 40, 0.12);
}

.dislike-button {
  color: #c94139;
}

.keep-button {
  color: #1f8a68;
}

.middle-button {
  width: 240rpx;
  background: #2d2118;
  color: #ffffff;
  line-height: 84rpx;
}

.summary-mascot {
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 8rpx;
}

.summary-text {
  color: rgba(45, 33, 24, 0.86);
  font-size: 29rpx;
  line-height: 1.68;
}

.summary-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.inline-button {
  flex: 1;
}

.empty-state {
  padding: 70rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 250, 240, 0.96);
  text-align: center;
}

.empty-text {
  color: #687077;
  font-size: 26rpx;
  line-height: 1.5;
}

.result-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(31, 36, 40, 0.09);
}

.result-image {
  width: 100%;
  height: 360rpx;
  background: #dfe6df;
}

.result-content {
  padding: 22rpx;
}

.dark-title {
  margin-top: 0;
  color: #1f2428;
  font-size: 38rpx;
}

.dark-dish {
  color: #d95d2d;
}

.result-ai-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: -4rpx 0 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.result-ai-avatar {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
}

.result-ai-copy {
  color: rgba(75, 50, 31, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.compact {
  margin-top: 14rpx;
  font-size: 26rpx;
}

.fixed-tags {
  margin-top: 16rpx;
}

.dark-tag {
  background: #eef2ef;
  color: #283039;
}

.alt-list,
.feedback-panel {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.alt-item {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0ed;
  color: #293039;
  font-size: 25rpx;
}

.feedback-textarea {
  min-height: 132rpx;
  margin-bottom: 18rpx;
}

.feedback-notice {
  margin: 16rpx 0 0;
}

.full-button {
  width: 100%;
  margin-top: 22rpx;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 36, 40, 0.2);
}

.loading-box {
  width: 420rpx;
  padding: 34rpx 30rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #293039;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: center;
  box-shadow: 0 22rpx 48rpx rgba(31, 36, 40, 0.18);
}

.loader {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 18rpx;
  border: 6rpx solid #d9e3db;
  border-top-color: #ff6334;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.debug-strip {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 26rpx;
  color: rgba(75, 50, 31, 0.52);
  font-size: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
