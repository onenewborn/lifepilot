page {
  min-height: 100%;
  background: #fff2dc;
  color: #2d2118;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  border: 0;
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff4df 0%, #ffe9c7 48%, #f8dcb4 100%);
}

.chat-page {
  height: 100vh;
  padding: 0 0 calc(196rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #f3eadc;
}

.chat-page .debug-strip {
  display: none;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.brand {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
  color: #2d2118;
}

.stage {
  display: block;
  margin-top: 4rpx;
  color: rgba(75, 50, 31, 0.68);
  font-size: 24rpx;
}

.status-pill {
  max-width: 320rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.62);
  color: rgba(55, 35, 22, 0.9);
  box-shadow: inset 0 0 0 1rpx rgba(125, 78, 44, 0.14);
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.notice,
.error {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.notice {
  background: rgba(255, 255, 255, 0.62);
  color: rgba(75, 50, 31, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(125, 78, 44, 0.1);
}

.error {
  background: #fde8e5;
  color: #a3342b;
}

.entry-panel,
.summary-panel,
.final-panel,
.diary-panel {
  padding: 28rpx;
  border-radius: 26rpx;
  background: rgba(255, 250, 240, 0.96);
  box-shadow: 0 20rpx 44rpx rgba(142, 92, 43, 0.16);
  border: 1rpx solid rgba(125, 78, 44, 0.12);
}

.chat-panel {
  height: 100%;
  padding: 0;
  background: transparent;
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #2d2118;
}

.entry-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.entry-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.location-chip {
  flex-shrink: 0;
  max-width: 270rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #ff6334;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.xiaowang-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 142rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.86);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.xiaowang-mascot {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}

.xiaowang-copy {
  flex: 1;
  min-width: 0;
}

.xiaowang-name {
  color: #2d2118;
  font-size: 30rpx;
  font-weight: 900;
}

.xiaowang-line {
  margin-top: 8rpx;
  color: rgba(75, 50, 31, 0.68);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.4;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: rgba(75, 50, 31, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.option-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 14rpx;
}

.option-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 66rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: rgba(45, 33, 24, 0.84);
  font-size: 25rpx;
  line-height: 66rpx;
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
  white-space: nowrap;
}

.option-pill.active {
  background: #ff6334;
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 10rpx 22rpx rgba(255, 99, 52, 0.24);
}

.budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.budget-value {
  flex-shrink: 0;
  color: #ff6334;
  font-size: 25rpx;
  font-weight: 900;
}

.budget-slider {
  margin: 4rpx 0 0;
}

.budget-scale {
  display: flex;
  justify-content: space-between;
  margin-top: -8rpx;
  color: rgba(75, 50, 31, 0.48);
  font-size: 20rpx;
  font-weight: 800;
}

.entry-textarea,
.feedback-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #1f2428;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 28rpx 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
}

.compact-location {
  margin: 24rpx 0 20rpx;
  padding: 16rpx 18rpx;
}

.top-location {
  margin-top: 18rpx;
}

.location-text {
  color: rgba(45, 33, 24, 0.84);
  font-size: 24rpx;
}

.primary-button,
.secondary-button,
.ghost-button,
.middle-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
  box-sizing: border-box;
}

.primary-button {
  width: 100%;
  background: #ff6334;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(255, 99, 52, 0.24);
}

.entry-actions {
  display: flex;
  gap: 14rpx;
}

.entry-secondary {
  flex: 0 0 220rpx;
}

.entry-primary {
  flex: 1;
}

.secondary-button {
  width: 220rpx;
  background: rgba(255, 255, 255, 0.8);
  color: rgba(45, 33, 24, 0.84);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.ghost-button {
  width: 132rpx;
  height: 62rpx;
  background: #ffffff;
  color: #ff6334;
  font-size: 24rpx;
  line-height: 62rpx;
}

.flow {
  min-height: 900rpx;
}

.offer-flow {
  min-height: 1280rpx;
}

.direction-brief {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 4rpx 0 14rpx;
  color: rgba(75, 50, 31, 0.64);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
}

.direction-brief-avatar {
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
}

.direction-brief-copy {
  flex: 1;
  min-width: 0;
}

.goal-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.goal-strip-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #2d2118;
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-edit-button {
  flex-shrink: 0;
  color: #ff6334;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.goal-editor {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.goal-editor-input {
  width: 100%;
  min-height: 112rpx;
  color: #2d2118;
  font-size: 26rpx;
  line-height: 1.45;
}

.goal-editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.goal-editor-button {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 25rpx;
}

.session-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 18rpx;
  color: #667078;
  font-size: 24rpx;
  font-weight: 700;
}

.offer-context-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 4rpx 0 16rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.08);
}

.offer-context-copy {
  flex: 1;
  min-width: 0;
}

.offer-context-label {
  color: rgba(75, 50, 31, 0.54);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.1;
}

.offer-context-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(45, 33, 24, 0.92);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.offer-context-count {
  flex-shrink: 0;
  color: #667078;
  font-size: 24rpx;
  font-weight: 900;
}

.offer-session-strip {
  margin-bottom: 14rpx;
}

.session-strip-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sound-toggle-button {
  min-width: 118rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #2d2118;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(45, 33, 24, 0.08);
}

.deck {
  position: relative;
  width: 100%;
  height: 930rpx;
}

.offer-flow .deck {
  height: 1220rpx;
}

.food-card {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  height: 900rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #1f2428;
  box-shadow: 0 26rpx 56rpx rgba(31, 36, 40, 0.18);
}

.offer-flow .food-card {
  height: 1190rpx;
  border-radius: 26rpx;
  background: #fffaf0;
  box-shadow: 0 22rpx 54rpx rgba(126, 74, 34, 0.2);
}

.next-card {
  top: 24rpx;
  transform: scale(0.95);
  opacity: 0.55;
}

.current-card {
  top: 0;
  z-index: 2;
}

.offer-card {
  display: flex;
  flex-direction: column;
  color: #2d2118;
}

.media {
  width: 100%;
  height: 100%;
}

.direction-swipe-surface {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.media-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46%;
  background: linear-gradient(180deg, rgba(31, 36, 40, 0) 0%, rgba(31, 36, 40, 0.42) 44%, rgba(31, 36, 40, 0.82) 100%);
}

.pause-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 4;
  transform: translate(-50%, -50%);
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(31, 36, 40, 0.28);
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 900;
}

.offer-pause-badge {
  top: 42%;
}

.card-body {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  z-index: 3;
  color: #ffffff;
}

.badge {
  display: inline-flex;
  max-width: 100%;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  line-height: 1.3;
}

.card-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
  word-break: break-word;
}

.dish-title {
  margin-top: 8rpx;
  color: #ffd68d;
  font-size: 28rpx;
  font-weight: 800;
}

.card-subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  max-width: 100%;
  padding: 9rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.35;
}

.offer-detail,
.direction-detail {
  margin-top: 18rpx;
}

.fact-line,
.reason-line {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.45;
}

.mini-title {
  margin-top: 16rpx;
  color: #ffd68d;
  font-size: 23rpx;
  font-weight: 900;
}

.muted-title,
.muted-line,
.muted-block .reason-line {
  color: rgba(255, 255, 255, 0.68);
}

.offer-media {
  position: relative;
  flex-shrink: 0;
  width: 100%;
  height: 720rpx;
  overflow: hidden;
  background: #201914;
}

.offer-media-asset {
  width: 100%;
  height: 100%;
}

.offer-video-source-switch {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  z-index: 5;
  display: flex;
  gap: 10rpx;
  max-width: 92%;
}

.offer-video-source-pill {
  min-width: 96rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(32, 25, 20, 0.42);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.offer-video-source-pill.active {
  background: rgba(255, 255, 255, 0.92);
  color: #2d2118;
}

.offer-gallery-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 150rpx;
  height: 54rpx;
  margin: 0 0 16rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 99, 52, 0.1);
  color: #ff6334;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(255, 99, 52, 0.18);
}

.offer-danmaku-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 96rpx;
  z-index: 4;
  height: 210rpx;
  overflow: hidden;
  pointer-events: none;
}

.offer-danmaku-item {
  position: absolute;
  left: 100%;
  max-width: 440rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 36, 40, 0.36);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
  animation-name: danmakuMove;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.danmaku-row-0 {
  top: 8rpx;
}

.danmaku-row-1 {
  top: 74rpx;
}

.danmaku-row-2 {
  top: 140rpx;
}

@keyframes danmakuMove {
  0% { transform: translateX(0); }
  100% { transform: translateX(-1180rpx); }
}

.offer-media-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42%;
  background: linear-gradient(180deg, rgba(31, 36, 40, 0) 0%, rgba(31, 36, 40, 0.24) 48%, rgba(31, 36, 40, 0.58) 100%);
}

.offer-info {
  flex: 1;
  min-height: 0;
  padding: 22rpx 24rpx 28rpx;
  background: #fffaf0;
  color: #2d2118;
  box-sizing: border-box;
}

.offer-title-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.offer-thumb {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  margin-right: 18rpx;
  border-radius: 8rpx;
  background: #f2dec0;
  box-shadow: inset 0 0 0 2rpx rgba(125, 78, 44, 0.12);
}

.offer-title-copy {
  flex: 1;
  min-width: 0;
}

.offer-merchant {
  overflow: hidden;
  color: #2d2118;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.offer-dish {
  margin-top: 6rpx;
  overflow: hidden;
  color: rgba(87, 51, 30, 0.74);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.24;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.offer-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.offer-tag {
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(236, 96, 50, 0.11);
  color: #6b3b22;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.offer-hook {
  margin-top: 12rpx;
  color: rgba(45, 33, 24, 0.9);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.42;
}

.offer-decision-block {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 16rpx 16rpx 18rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(87, 51, 30, 0.08);
}

.offer-decision-mascot {
  flex: 0 0 74rpx;
  width: 74rpx;
  height: 74rpx;
}

.offer-decision-copy {
  flex: 1;
  min-width: 0;
}

.decision-section + .decision-section {
  margin-top: 14rpx;
}

.decision-title {
  color: #8a4a28;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.decision-line {
  margin-top: 7rpx;
  color: rgba(45, 33, 24, 0.76);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.38;
}

.muted-decision-section .decision-title,
.muted-decision-section .decision-line {
  color: rgba(45, 33, 24, 0.58);
}

.offer-action-bar {
  gap: 22rpx;
  margin-top: 14rpx;
}

.offer-action-bar .round-button {
  width: 132rpx;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 52rpx;
}

.offer-action-bar .middle-button {
  width: 220rpx;
  height: 86rpx;
  border-radius: 18rpx;
  background: #2d2118;
  color: #fff4df;
  line-height: 86rpx;
}

.swipe-mark {
  position: absolute;
  top: 56rpx;
  z-index: 5;
  padding: 14rpx 20rpx;
  border: 5rpx solid currentColor;
  border-radius: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
  opacity: 0;
}

.keep-mark {
  right: 46rpx;
  color: #47d18c;
  transform: rotate(12deg);
}

.dislike-mark {
  left: 46rpx;
  color: #ff746c;
  transform: rotate(-12deg);
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-top: 4rpx;
}

.round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  background: #ffffff;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 116rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 36rpx rgba(31, 36, 40, 0.12);
}

.dislike-button {
  color: #c94139;
}

.keep-button {
  color: #1f8a68;
}

.middle-button {
  width: 240rpx;
  background: #2d2118;
  color: #ffffff;
  line-height: 84rpx;
}

.summary-mascot {
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 8rpx;
}

.summary-text {
  color: rgba(45, 33, 24, 0.86);
  font-size: 29rpx;
  line-height: 1.68;
}

