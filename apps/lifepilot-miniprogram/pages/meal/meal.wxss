  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.diary-title {
  margin-bottom: 0;
}

.diary-refresh {
  background: #2d2118;
  color: #fff8ec;
}

.diary-section {
  margin-top: 22rpx;
}

.diary-summary-card {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(45, 33, 24, 0.9);
  color: #fff8ec;
}

.diary-summary-label {
  color: rgba(255, 248, 236, 0.68);
  font-size: 21rpx;
  font-weight: 900;
}

.diary-summary-text {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.diary-summary-next {
  margin-top: 10rpx;
  color: rgba(255, 248, 236, 0.72);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.diary-item,
.memory-candidate {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: inset 0 0 0 1rpx rgba(125, 78, 44, 0.1);
}

.observation-item {
  background: rgba(255, 248, 236, 0.78);
}

.food-profile-card {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(45, 33, 24, 0.94), rgba(122, 59, 36, 0.9));
  color: #fff8ec;
  box-shadow: 0 18rpx 42rpx rgba(45, 33, 24, 0.16);
}

.food-profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.food-profile-title {
  font-size: 28rpx;
  font-weight: 950;
}

.food-profile-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 248, 236, 0.66);
  font-size: 21rpx;
  font-weight: 800;
}

.food-profile-confidence {
  min-width: 84rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 236, 0.14);
  color: #ffd09c;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 54rpx;
  text-align: center;
}

.motivation-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.motivation-row {
  display: grid;
  grid-template-columns: 120rpx 1fr 52rpx;
  align-items: center;
  gap: 14rpx;
}

.motivation-label {
  color: rgba(255, 248, 236, 0.86);
  font-size: 22rpx;
  font-weight: 900;
}

.motivation-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 236, 0.13);
  overflow: hidden;
}

.motivation-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff6334, #ffd09c);
}

.motivation-score {
  color: #ffd09c;
  font-size: 22rpx;
  font-weight: 950;
  text-align: right;
}

.profile-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.profile-chip {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 236, 0.12);
  color: rgba(255, 248, 236, 0.76);
  font-size: 20rpx;
  font-weight: 850;
}

.diary-item-title {
  margin-top: 8rpx;
  color: #2d2118;
  font-size: 28rpx;
  font-weight: 900;
}

.diary-item-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  color: rgba(75, 50, 31, 0.48);
  font-size: 21rpx;
  font-weight: 800;
}

.diary-item-text,
.memory-candidate-text,
.diary-empty {
  margin-top: 8rpx;
  color: rgba(75, 50, 31, 0.66);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.diary-empty {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.52);
}

.preference-time {
  margin-top: 4rpx;
  color: rgba(75, 50, 31, 0.42);
  font-size: 20rpx;
  font-weight: 800;
}

.memory-candidate-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.memory-edit-box {
  margin-top: 14rpx;
}

.memory-edit-input {
  width: 100%;
  min-height: 74rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #2d2118;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
  box-sizing: border-box;
}

.memory-skip-button {
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(45, 33, 24, 0.08);
  color: rgba(75, 50, 31, 0.68);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.preference-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.preference-pill {
  max-width: 100%;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 99, 52, 0.1);
  color: #7a3b24;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes thinkingPulse {
  0%,
  60%,
  100% {
    opacity: 0.25;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}
