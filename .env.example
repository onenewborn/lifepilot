LIFEPILOT_AI_PROVIDER=ark
ARK_API_KEY=ark-...
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-flash-250828
ARK_TIMEOUT_MS=12000
ARK_MAX_TOKENS=512
ARK_TEMPERATURE=0.2

LIFEPILOT_WEATHER_PROVIDER=amap
LIFEPILOT_MAP_PROVIDER=amap
LIFEPILOT_AMAP_KEY=

# 云端开启网页数据管理台时请务必配置。网页端会用这个口令调用 /api/admin/*。
LIFEPILOT_ADMIN_TOKEN=

# Evermind 是外部记忆 provider。产品后端仍然是 confirmed preference 的权威账本。
EVERMIND_API_KEY=
EVERMIND_API_BASE_URL=https://api.evermind.ai
