{
  "schema_version": "lifepilot.dreaming.conflict_rules.v1",
  "rules": [
    {
      "name": "temporary_light_vs_usual_heavy",
      "if_new_signal_contains": ["今天", "最近", "有点重", "轻一点", "清淡"],
      "if_existing_contains": ["重口", "辣", "下饭"],
      "action": "situational_preference"
    },
    {
      "name": "merchant_bad_experience_not_global_dislike",
      "if_new_signal_contains": ["这家", "这店", "环境", "服务", "排队", "太油"],
      "action": "merchant_experience"
    }
  ]
}
